{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TimeSeriesAssociation",
  "type": "object",
  "description": "Metadata linking one time series to the component or attribute that owns it. A closed set of six canonical types: two static, four forecasts. The type decides which timing fields the row carries. Dense values never appear here.",
  "discriminator": {
    "propertyName": "time_series_type",
    "mapping": {
      "SingleTimeSeries": "#/components/schemas/SingleTimeSeries",
      "NonSequentialTimeSeries": "#/components/schemas/NonSequentialTimeSeries",
      "Deterministic": "#/components/schemas/Deterministic",
      "DeterministicSingleTimeSeries": "#/components/schemas/DeterministicSingleTimeSeries",
      "Probabilistic": "#/components/schemas/Probabilistic",
      "Scenarios": "#/components/schemas/Scenarios"
    }
  },
  "oneOf": [
    {
      "$ref": "SingleTimeSeries.json"
    },
    {
      "$ref": "NonSequentialTimeSeries.json"
    },
    {
      "$ref": "Deterministic.json"
    },
    {
      "$ref": "DeterministicSingleTimeSeries.json"
    },
    {
      "$ref": "Probabilistic.json"
    },
    {
      "$ref": "Scenarios.json"
    }
  ]
}
