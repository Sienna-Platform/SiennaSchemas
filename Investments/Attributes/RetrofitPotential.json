{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "id": {
      "type": "integer",
      "description": "ID for individual component"
    },
    "eligible_generators": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Names of individual generation units mapped to this technology that can be retrofitted"
    }
  },
  "required": [
    "id",
    "eligible_generators"
  ],
  "title": "RetrofitPotential",
  "type": "object"
}
