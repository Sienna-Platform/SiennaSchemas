{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": [
        "id",
        "retrofit_id",
        "retrofit_fraction"
    ],
    "properties": {
        "id": {
            "type": "integer"
        },
        "retrofit_id": {
            "type": "integer"
        },
        "retrofit_potential": {
            "type": "number",
            "default": 0.0
        },
        "retrofit_fraction": {
            "type": "number"
        }
    }
}
