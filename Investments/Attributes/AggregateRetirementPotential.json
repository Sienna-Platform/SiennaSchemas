{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "id": {
      "description": "ID for individual component.",
      "type": "integer"
    },
    "retirement_potential": {
      "description": "Amount of pre-existing capacity for a technology that is eligible for retirement. Units: MW.",
      "type": "number",
      "default": 0.0,
      "x-unit": "MW"
    }
  },
  "required": [
    "id",
    "retirement_potential"
  ],
  "title": "AggregateRetirementPotential",
  "type": "object"
}
