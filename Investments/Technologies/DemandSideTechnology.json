  "required": [
    "name",
    "id",
    "available",
    "region",
    "power_systems_type",
    "price_per_unit",
    "max_demand_delay",
    "max_demand_advance",
    "demand_energy_efficiency",
    "shift_variable_cost",
    "curtailment_cost",
