    "max_demand_delay": {
      "type": "number"
    },
    "max_demand_advance": {
      "type": "number"
    },
    "demand_energy_efficiency": {
      "type": "number"
    },
    "shift_variable_cost": {
      "$ref": "../../Core/common.json#/definitions/ValueCurve"
    },
    "curtailment_cost": {
      "$ref": "../../Core/common.json#/definitions/ValueCurve"
    },
    "max_demand_curtailment": {
      "type": "number"
    },
    "requirements": {
      "type": "array",
      "default": [],
