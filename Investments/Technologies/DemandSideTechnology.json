  "properties": {
    "id": {
      "type": "integer"
    },
    "name": {
      "type": "string"
    },
    "available": {
      "type": "boolean"
    },
    "region": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "power_systems_type": {
      "type": "string"
    },
    "technology_efficiency": {
      "type": "number",
      "default": 0.0
    },
    "price_per_unit": {
      "$ref": "../../Core/common.json#/definitions/ValueCurve"
