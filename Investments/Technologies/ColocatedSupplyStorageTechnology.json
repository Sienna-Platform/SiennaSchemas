{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": [
        "name",
        "available",
        "power_systems_type"
    ],
    "properties": {
        "name": {
            "type": "string"
        },
        "id": {
            "type": "integer"
        },
        "power_systems_type": {
            "type": "string"
        },
        "base_year": {
            "type": "integer"
        },
        "region": {
            "type": "array",
            "items": {
                "type": "integer"
            }
        },
        "financial_data": {
            "$ref": "../../Core/common.json#/definitions/TechnologyFinancialData"
        },
        "available": {
            "type": "boolean"
        },
        "balancing_topology": {
            "type": "string"
        },
        "capital_costs_solar": {
            "$ref": "../../Core/common.json#/definitions/ValueCurve",
            "x-unit": "USD/MW",
            "description": "Units: USD/MW."
        },
        "operation_costs_solar": {
            "$ref": "../../Core/common.json#/definitions/RenewableGenerationCost",
            "x-unit": "USD/MWh",
            "description": "Units: USD/MWh."
        },
        "capacity_limits_solar": {
            "$ref": "../../Core/common.json#/definitions/MinMax",
            "x-unit": "MW",
            "description": "Units: MW."
        },
        "lifetime_solar": {
            "type": "integer",
            "x-unit": "yr",
            "description": "Units: yr."
        },
        "capital_costs_wind": {
            "$ref": "../../Core/common.json#/definitions/ValueCurve",
            "x-unit": "USD/MW",
            "description": "Units: USD/MW."
        },
        "operation_costs_wind": {
            "$ref": "../../Core/common.json#/definitions/RenewableGenerationCost",
            "x-unit": "USD/MWh",
            "description": "Units: USD/MWh."
        },
        "capacity_limits_wind": {
            "$ref": "../../Core/common.json#/definitions/MinMax",
            "x-unit": "MW",
            "description": "Units: MW."
        },
        "lifetime_wind": {
            "type": "integer",
            "x-unit": "yr",
            "description": "Units: yr."
        },
        "capital_costs_energy": {
            "$ref": "../../Core/common.json#/definitions/ValueCurve",
            "x-unit": "USD/MWh",
            "description": "Units: USD/MWh."
        },
        "capital_costs_power": {
            "$ref": "../../Core/common.json#/definitions/ValueCurve",
            "x-unit": "USD/MW",
            "description": "Units: USD/MW."
        },
        "operation_costs_energy": {
            "$ref": "../../Core/common.json#/definitions/StorageCost",
            "x-unit": "USD/MWh",
            "description": "Units: USD/MWh."
        },
        "operation_costs_power": {
            "$ref": "../../Core/common.json#/definitions/StorageCost",
            "x-unit": "USD/MWh",
            "description": "Units: USD/MWh."
        },
        "capacity_power_limits": {
            "$ref": "../../Core/common.json#/definitions/MinMax",
            "x-unit": "MW",
            "description": "Units: MW."
        },
        "capacity_energy_limits": {
            "$ref": "../../Core/common.json#/definitions/MinMax",
            "x-unit": "MWh",
            "description": "Units: MWh."
        },
        "duration_limits": {
            "$ref": "../../Core/common.json#/definitions/MinMax",
            "x-unit": "h",
            "description": "Units: h."
        },
        "efficiency_storage": {
            "$ref": "../../Core/common.json#/definitions/InOut",
            "x-unit": "1",
            "description": "Units: 1."
        },
        "losses_storage": {
            "type": "number",
            "default": "1.0",
            "x-unit": "1",
            "description": "Units: 1."
        },
        "lifetime_storage": {
            "type": "integer",
            "default": "100",
            "x-unit": "yr",
            "description": "Units: yr."
        },
        "max_inverter_capacity": {
            "type": "number",
            "x-unit": "MW",
            "description": "Units: MW."
        },
        "min_inverter_capacity": {
            "type": "number",
            "x-unit": "MW",
            "description": "Units: MW."
        },
        "capital_costs_inverter": {
            "$ref": "../../Core/common.json#/definitions/ValueCurve",
            "x-unit": "USD/MW",
            "description": "Units: USD/MW."
        },
        "operation_costs_inverter": {
            "$ref": "../../Core/common.json#/definitions/ProductionVariableCostCurve"
        },
        "inverter_efficiency": {
            "type": "number",
            "x-unit": "1",
            "description": "Units: 1."
        },
        "inverter_supply_ratio": {
            "type": "number"
        }
    }
}
