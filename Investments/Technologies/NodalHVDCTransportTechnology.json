{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": [
        "name",
        "available",
        "id"
    ],
    "properties": {
        "name": {
            "type": "string"
        },
        "id": {
            "type": "integer"
        },
        "available": {
            "type": "boolean"
        },
        "power_systems_type": {
            "type": "string"
        },
        "start_node": {
            "type": "integer"
        },
        "end_node": {
            "type": "integer"
        },
        "capacity_limits": {
            "$ref": "../../Core/common.json#/definitions/MinMax"
        },
        "capital_costs": {
            "$ref": "../../Core/common.json#/definitions/ValueCurve",
            "x-unit": "USD/MW",
            "description": "Units: USD/MW."
        },
        "line_loss": {
            "$ref": "../../Core/common.json#/definitions/ValueCurve",
            "x-unit": "1",
            "description": "Units: 1."
        },
        "unit_size": {
            "type": "number",
            "x-unit": "MW",
            "description": "Units: MW."
        },
        "financial_data": {
            "$ref": "../../Core/common.json#/definitions/TechnologyFinancialData"
        }
    }
}
