{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": [
        "capital_recovery_period",
        "technology_base_year"
    ],
    "properties": {
        "id": {
            "type": "integer"
        },
        "capital_recovery_period": {
            "type": "integer"
        },
        "technology_base_year": {
            "type": "integer"
        },
        "debt_fraction": {
            "type": "number"
        },
        "debt_rate": {
            "type": "number"
        },
        "return_on_equity": {
            "type": "number"
        },
        "tax_rate": {
            "type": "number"
        }        
    }
  }