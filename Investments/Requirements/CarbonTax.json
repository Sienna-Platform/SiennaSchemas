{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "id": {
      "type": "integer"
    },
    "name": {
      "type": "string"
    },
    "available": {
      "type": "boolean"
    },
    "target_year": {
      "type": "integer"
    },
    "tax_dollars_per_ton": {
      "type": "number",
      "default": 0.0,
      "x-unit": "USD/t",
      "description": "Units: USD/t."
    }
  },
  "required": [
    "id",
    "name",
    "available"
  ],
  "title": "CarbonTax",
  "type": "object"
}
