{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "id": {
      "type": "integer"
    },
    "name": {
      "type": "string"
    },
    "available": {
      "type": "boolean"
    },
    "target_year": {
      "type": "integer"
    },
    "max_tons_mwh": {
      "type": "number",
      "default": 100000000,
      "x-unit": "Mt/MWh",
      "description": "Units: Mt/MWh."
    },
    "max_mtons": {
      "type": "number",
      "x-unit": "Mt",
      "description": "Units: Mt."
    }
  },
  "required": [
    "name",
    "id",
    "available",
    "target_year",
    "max_mtons"
  ],
  "title": "CarbonCaps",
  "type": "object"
}
