{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": [
        "name",
        "id",
        "available",
        "target_year",
        "max_mtons"
    ],
    "properties": {
        "name": {
            "type": "string"
        },
        "id": {
            "type": "integer"
        },
        "available": {
            "type": "boolean"
        },
        "target_year": {
            "type": "integer"
        },
        "max_tons_mwh": {
            "type": "number",
            "default": 100000000
        },
        "max_mtons": {
            "type": "number"
        }
    }
}
