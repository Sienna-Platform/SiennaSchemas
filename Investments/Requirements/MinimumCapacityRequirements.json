{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": [
        "name",
        "id",
        "available",
        "target_year",
        "min_capacity_mw"
    ],
    "properties": {
        "name": {
            "type": "string"
        },
        "id": {
            "type": "integer"
        },
        "available": {
            "type": "boolean"
        },
        "target_year": {
            "type": "integer"
        },
        "min_capacity_mw": {
            "type": "number"
        }
    }
}
