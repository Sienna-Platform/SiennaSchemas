{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "An infinite bus with a constant voltage output.\n\nCommonly used in dynamics simulations to represent a very large machine on a single bus or for the representation of import/exports in operational simulations.",
  "properties": {
    "id": {
      "description": "Unique integer identifier for this component.",
      "type": "integer"
    },
    "name": {
      "description": "Name of the component. Components of the same type (e.g., `PowerLoad`) must have unique names, but components of different types (e.g., `PowerLoad` and `ACBus`) can have the same name.",
      "type": "string"
    },
    "available": {
      "description": "Indicator of whether the component is connected and online (`true`) or disconnected, offline, or down (`false`). Unavailable components are excluded during simulations.",
      "type": "boolean"
    },
    "bus": {
      "description": "ID of the bus that this component is connected to.",
      "type": "integer"
    },
    "active_power": {
      "description": "Initial active power set point of the unit. For power flow, this is the steady state operating point of the system. For production cost modeling, this may or may not be used as the initial starting point for the solver, depending on the solver used.",
      "default": 0.0,
      "type": "number",
      "x-unit": "MW"
    },
    "reactive_power": {
      "description": "Initial reactive power set point of the unit.",
      "default": 0.0,
      "type": "number",
      "x-unit": "MW"
    },
    "active_power_limits": {
      "description": "Minimum and maximum stable active power levels.",
      "default": {
        "min": 0.0,
        "max": 0.0
      },
      "$ref": "../../Core/common.json#/definitions/MinMax",
      "x-unit": "MW"
    },
    "reactive_power_limits": {
      "description": "Minimum and maximum reactive power limits. Set to `null` if not applicable.",
      "default": {
        "min": 0.0,
        "max": 0.0
      },
      "$ref": "../../Core/common.json#/definitions/MinMax",
      "x-unit": "MW"
    },
    "R_th": {
      "description": "Source Thevenin resistance.",
      "default": 0.0,
      "type": "number"
    },
    "X_th": {
      "description": "Source Thevenin reactance.",
      "default": 0.0,
      "type": "number"
    },
    "internal_voltage": {
      "description": "Internal voltage.",
      "default": 1.0,
      "type": "number"
    },
    "internal_angle": {
      "description": "Internal angle.",
      "default": 0.0,
      "type": "number",
      "x-unit": "rad"
    },
    "base_power": {
      "description": "Base power of the unit for per unitization.",
      "default": 100.0,
      "type": "number",
      "x-unit": "MW"
    },
    "operation_cost": {
      "description": "ImportExportCost of the source.",
      "descriptor": "default PSY.ImportExportCost(nothing)",
      "default": {
        "import_offer_curves": {
          "variable_cost_type": "COST",
          "value_curve": {
            "curve_type": "INPUT_OUTPUT",
            "function_data": {
              "function_type": "LINEAR",
              "constant_term": 0,
              "proportional_term": 0
            },
            "input_at_zero": 0
          },
          "vom_cost": {
            "curve_type": "INPUT_OUTPUT",
            "function_data": {
              "function_type": "LINEAR",
              "constant_term": 0,
              "proportional_term": 0
            },
            "input_at_zero": 0
          }
        },
        "export_offer_curves": {
          "variable_cost_type": "COST",
          "value_curve": {
            "curve_type": "INPUT_OUTPUT",
            "function_data": {
              "function_type": "LINEAR",
              "constant_term": 0,
              "proportional_term": 0
            },
            "input_at_zero": 0
          },
          "vom_cost": {
            "curve_type": "INPUT_OUTPUT",
            "function_data": {
              "function_type": "LINEAR",
              "constant_term": 0,
              "proportional_term": 0
            },
            "input_at_zero": 0
          }
        },
        "energy_import_weekly_limit": 1000000.0,
        "energy_export_weekly_limit": 1000000.0
      },
      "$ref": "../../Core/common.json#/definitions/ImportExportCost"
    },
    "dynamic_injector": {
      "description": "Corresponding dynamic injection device.",
      "type": null
    }
  },
  "required": [
    "id",
    "name",
    "available",
    "bus",
    "operation_cost"
  ],
  "title": "Source",
  "type": "object"
}
