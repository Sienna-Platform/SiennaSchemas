{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "id": {
      "type": "integer"
    },
    "name": {
      "type": "string"
    },
    "available": {
      "type": "boolean"
    },
    "storage_level_limits": {
      "$ref": "../../Core/common.json#/definitions/MinMax",
      "x-unit-discriminator": "level_data_type",
      "x-units": {
        "USABLE_VOLUME": "m3",
        "TOTAL_VOLUME": "m3",
        "HEAD": "m",
        "ENERGY": "MWh"
      },
      "description": "Units: per level_data_type — USABLE_VOLUME: m3, TOTAL_VOLUME: m3, HEAD: m, ENERGY: MWh ."
    },
    "initial_level": {
      "type": "number",
      "x-unit-discriminator": "level_data_type",
      "x-units": {
        "USABLE_VOLUME": "m3",
        "TOTAL_VOLUME": "m3",
        "HEAD": "m",
        "ENERGY": "MWh"
      },
      "description": "Units: per level_data_type — USABLE_VOLUME: m3, TOTAL_VOLUME: m3, HEAD: m, ENERGY: MWh ."
    },
    "spillage_limits": {
      "description": "in psy5 a required param with an option to be nothing Units: per level_data_type — USABLE_VOLUME: m3/s, TOTAL_VOLUME: m3/s, HEAD: m/s, ENERGY: MW .",
      "$ref": "../../Core/common.json#/definitions/MinMax",
      "x-unit-discriminator": "level_data_type",
      "x-units": {
        "USABLE_VOLUME": "m3/s",
        "TOTAL_VOLUME": "m3/s",
        "HEAD": "m/s",
        "ENERGY": "MW"
      }
    },
    "inflow": {
      "type": "number",
      "x-unit-discriminator": "level_data_type",
      "x-units": {
        "USABLE_VOLUME": "m3/s",
        "TOTAL_VOLUME": "m3/s",
        "HEAD": "m/s",
        "ENERGY": "MW"
      },
      "description": "Units: per level_data_type — USABLE_VOLUME: m3/s, TOTAL_VOLUME: m3/s, HEAD: m/s, ENERGY: MW ."
    },
    "outflow": {
      "type": "number",
      "x-unit-discriminator": "level_data_type",
      "x-units": {
        "USABLE_VOLUME": "m3/s",
        "TOTAL_VOLUME": "m3/s",
        "HEAD": "m/s",
        "ENERGY": "MW"
      },
      "description": "Units: per level_data_type — USABLE_VOLUME: m3/s, TOTAL_VOLUME: m3/s, HEAD: m/s, ENERGY: MW ."
    },
    "level_targets": {
      "description": "in psy5 a required param with an option to be nothing Units: per level_data_type — USABLE_VOLUME: m3, TOTAL_VOLUME: m3, HEAD: m, ENERGY: MWh .",
      "type": "number",
      "x-unit-discriminator": "level_data_type",
      "x-units": {
        "USABLE_VOLUME": "m3",
        "TOTAL_VOLUME": "m3",
        "HEAD": "m",
        "ENERGY": "MWh"
      }
    },
    "intake_elevation": {
      "type": "number",
      "x-unit": "m",
      "description": "Units: m."
    },
    "head_to_volume_factor": {
      "description": "`FunctionData` mapping reservoir head to stored volume.",
      "$ref": "../../Core/common.json#/definitions/FunctionData"
    },
    "upstream_turbines": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "downstream_turbines": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "upstream_reservoirs": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "operation_cost": {
      "$ref": "../../Core/common.json#/definitions/HydroReservoirCost"
    },
    "evaporative_loss": {
      "description": "Standing loss from evaporation as a fraction of the reservoir's stored volume/energy lost per hour. Units: 1.",
      "default": 0.0,
      "type": "number",
      "x-unit": "1"
    },
    "level_data_type": {
      "default": "USABLE_VOLUME",
      "type": "string",
      "enum": [
        "USABLE_VOLUME",
        "TOTAL_VOLUME",
        "HEAD",
        "ENERGY"
      ]
    }
  },
  "required": [
    "id",
    "name",
    "available",
    "storage_level_limits",
    "initial_level",
    "inflow",
    "outflow",
    "intake_elevation",
    "head_to_volume_factor",
    "operation_cost"
  ],
  "title": "HydroReservoir",
  "type": "object"
}
