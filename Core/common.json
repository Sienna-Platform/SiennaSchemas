      "title": "InOut",
      "type": "object"
    },
    "InputOutputCurve": {
      "default": {
        "curve_type": "INPUT_OUTPUT",
        "function_data": {
          "function_type": "LINEAR",
          "constant_term": 0,
          "proportional_term": 0
        }
      },
      "properties": {
        "curve_type": {
          "const": "INPUT_OUTPUT",
          "type": "string",
          "default": "INPUT_OUTPUT"
        },
        "function_data": {
          "discriminator": {
            "mapping": {
              "LINEAR": "#/components/schemas/LinearFunctionData",
              "PIECEWISE_LINEAR": "#/components/schemas/PiecewiseLinearData",
