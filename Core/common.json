    "HydroGenerationCost": {
      "description": "Cost representation for hydro gen units",
      "properties": {
        "cost_type": {
          "const": "HYDRO_GEN",
          "type": "string",
          "default": "HYDRO_GEN"
        },
        "fixed": {
          "default": 0.0,
          "type": "number"
        },
        "variable": {
          "$ref": "#/definitions/ProductionVariableCostCurve"
        }
      },
      "required": [
        "variable"
      ],
      "title": "HydroGenerationCost",
      "type": "object"
    },
    "HydroReservoirCost": {
      "description": "Cost representation for hydro reservoir",
      "properties": {
        "cost_type": {
          "const": "HYDRO_RES",
          "type": "string",
          "default": "HYDRO_RES"
        },
        "level_shortage_cost": {
          "default": 0.0,
          "type": "number"
        },
        "level_surplus_cost": {
          "default": 0.0,
          "type": "number"
        },
        "spillage_cost": {
          "default": 0.0,
          "type": "number"
        }
      },
      "title": "HydroReservoirCost",
      "type": "object"
    },
    "HydroStorageGenerationCost": {
      "title": "HydroStorageGenerationCost",
      "type": "object",
      "discriminator": {
        "mapping": {
          "HYDRO_GEN": "#/components/schemas/HydroGenerationCost",
          "STORAGE": "#/components/schemas/StorageCost"
        },
        "propertyName": "cost_type"
      },
      "oneOf": [
        {
          "$ref": "#/definitions/HydroGenerationCost"
        },
        {
          "$ref": "#/definitions/StorageCost"
        }
      ]
    },
    "ImpedanceUnitBasis": {
      "description": "Unit basis a branch/injection impedance is stored in. NATURAL_UNITS: physical ohms (PSS/E RAW native for DC-line impedances). DEVICE_BASE: per-unit on the component's own base (base_power MVA and voltage base); components whose per-unit data was historically on the system base record that system base in base_power, so there is no separate system-base option. PSS/E supplies device base for DC-line converters and CZ=2 transformer windings.",
      "enum": [
        "NATURAL_UNITS",
        "DEVICE_BASE"
      ],
      "title": "ImpedanceUnitBasis",
      "type": "string"
    },
    "AdmittanceUnitBasis": {
      "description": "Unit basis a shunt admittance is stored in. NATURAL_UNITS: physical siemens. DEVICE_MVAR: reactive power at unity voltage (Mvar for susceptance, MW for conductance). DEVICE_BASE: per-unit on the component's own base (base_power MVA and voltage base) \u2014 a per-unit base, not a power at unity voltage, and not an alternative spelling of DEVICE_MVAR; components whose per-unit data was historically on the system base record that system base in base_power. Fixed and switched shunts use ShuntAdmittanceUnitBasis instead, which omits DEVICE_BASE because a shunt has no device MVA rating.",
      "enum": [
        "NATURAL_UNITS",
        "DEVICE_MVAR",
        "DEVICE_BASE"
      ],
      "title": "AdmittanceUnitBasis",
      "type": "string"
    },
    "ShuntAdmittanceUnitBasis": {
      "description": "Subset of AdmittanceUnitBasis for fixed and switched shunts: omits DEVICE_BASE because a shunt has no device MVA rating to per-unitize against. NATURAL_UNITS: physical siemens. DEVICE_MVAR: reactive power at unity voltage (Mvar for susceptance, MW for conductance) \u2014 PSS/E RAW native for shunts.",
      "enum": [
        "NATURAL_UNITS",
        "DEVICE_MVAR"
      ],
      "title": "ShuntAdmittanceUnitBasis",
      "type": "string"
    },
