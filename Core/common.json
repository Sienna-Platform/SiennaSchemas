{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ACBusType": {
      "enum": [
        "PQ",
        "PV",
        "REF",
        "ISOLATED",
        "SLACK"
      ],
      "title": "ACBusType",
      "type": "string"
    },
    "AverageRateCurve": {
      "properties": {
        "curve_type": {
          "const": "AVERAGE_RATE",
          "type": "string",
          "default": "AVERAGE_RATE"
        },
        "function_data": {
          "discriminator": {
            "mapping": {
              "LINEAR": "#/components/schemas/LinearFunctionData",
              "PIECEWISE_STEP": "#/components/schemas/PiecewiseStepData"
            },
            "propertyName": "function_type"
          },
          "oneOf": [
            {
              "$ref": "#/definitions/LinearFunctionData"
            },
            {
              "$ref": "#/definitions/PiecewiseStepData"
            }
          ]
        },
        "initial_input": {
          "type": "number"
        },
        "input_at_zero": {
          "type": "number"
        }
      },
      "required": [
        "function_data",
        "curve_type"
      ],
      "title": "AverageRateCurve",
      "type": "object"
    },
    "ComplexNumber": {
      "properties": {
        "real": {
          "type": "number"
        },
        "imag": {
          "type": "number"
        }
      },
      "title": "ComplexNumber",
      "type": "object"
    },
    "CostCurve": {
      "properties": {
        "power_units": {
          "default": "NATURAL_UNITS",
          "$ref": "#/definitions/UnitSystem"
        },
        "value_curve": {
          "$ref": "#/definitions/ValueCurve"
        },
        "variable_cost_type": {
          "const": "COST",
          "type": "string",
          "default": "COST"
        },
        "vom_cost": {
          "default": {
            "curve_type": "INPUT_OUTPUT",
            "function_data": {
              "function_type": "LINEAR",
              "constant_term": 0,
              "proportional_term": 0
            }
          },
          "$ref": "#/definitions/InputOutputCurve"
        }
      },
      "required": [
        "value_curve",
        "power_units",
        "vom_cost",
        "variable_cost_type"
      ],
      "title": "CostCurve",
      "type": "object"
    },
    "DbdPnts": {
      "properties": {
        "dbd1": {
          "type": "number"
        },
        "dbd2": {
          "type": "number"
        }
      },
      "title": "DbdPnts",
      "type": "object"
    },
    "EmissionBasis": {
      "enum": [
        "FUEL_INPUT",
        "POWER_OUTPUT"
      ],
      "title": "EmissionBasis",
      "type": "string"
    },
    "EnergyUnit": {
      "enum": [
        "MMBTU",
        "GJ",
        "MWH"
      ],
      "title": "EnergyUnit",
      "type": "string"
    },
    "EnergyUnitBasis": {
      "description": "Unit basis a stored-energy quantity is recorded in (distinct from EnergyUnit, which names fuel energy content). MWH: megawatt-hours, the conventional interchange form. MWMIN: megawatt-minutes, consistent with the minutes basis used for operational durations, so a duration computed as energy over power comes out in minutes with no hidden factor of 60. Defaults to MWH: MWMIN is supported, not preferred.",
      "enum": [
        "MWH",
        "MWMIN"
      ],
      "title": "EnergyUnitBasis",
      "type": "string"
    },
    "FdbdPnts": {
      "properties": {
        "fdbd1": {
          "type": "number"
        },
        "fdbd2": {
          "type": "number"
        }
      },
      "title": "FdbdPnts",
      "type": "object"
    },
    "FromTo": {
      "properties": {
        "from": {
          "title": "From",
          "type": "number"
        },
        "to": {
          "title": "To",
          "type": "number"
        }
      },
      "title": "FromTo",
      "type": "object"
    },
    "FromTo_ToFrom": {
      "properties": {
        "from_to": {
          "title": "FromTo",
          "type": "number"
        },
        "to_from": {
          "title": "ToFrom",
          "type": "number"
        }
      },
      "title": "FromTo_ToFrom",
      "type": "object"
    },
    "FuelCurve": {
      "properties": {
        "fuel_cost": {
          "type": [
            "number",
            "null"
          ],
          "description": "Fixed fuel cost per unit of fuel, or null when fuel_cost_time_series names a time-varying one. Exactly one of the two is set; producers and consumers enforce it."
        },
        "fuel_cost_time_series": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Store-minted id of the fuel-cost time series association, or null when fuel_cost carries a fixed value. Exactly one of the two is set."
        },
        "power_units": {
          "$ref": "#/definitions/UnitSystem"
        },
        "startup_fuel_offtake": {
          "description": "Fuel consumed during startup, as a curve in the unit's fuel units.",
          "$ref": "#/definitions/InputOutputCurve"
        },
        "value_curve": {
          "$ref": "#/definitions/ValueCurve"
        },
        "variable_cost_type": {
          "const": "FUEL",
          "type": "string",
          "default": "FUEL"
        },
        "vom_cost": {
          "$ref": "#/definitions/InputOutputCurve"
        }
      },
      "required": [
        "value_curve",
        "power_units",
        "vom_cost",
        "variable_cost_type"
      ],
      "title": "FuelCurve",
      "type": "object"
    },
    "FunctionData": {
      "discriminator": {
        "mapping": {
          "LINEAR": "#/components/schemas/LinearFunctionData",
          "PIECEWISE_LINEAR": "#/components/schemas/PiecewiseLinearData",
          "PIECEWISE_STEP": "#/components/schemas/PiecewiseStepData",
          "QUADRATIC": "#/components/schemas/QuadraticFunctionData",
          "TIME_SERIES_LINEAR": "#/components/schemas/TimeSeriesLinearFunctionData",
          "TIME_SERIES_QUADRATIC": "#/components/schemas/TimeSeriesQuadraticFunctionData",
          "TIME_SERIES_PIECEWISE_LINEAR": "#/components/schemas/TimeSeriesPiecewiseLinearData",
          "TIME_SERIES_PIECEWISE_STEP": "#/components/schemas/TimeSeriesPiecewiseStepData"
        },
        "propertyName": "function_type"
      },
      "oneOf": [
        {
          "$ref": "#/definitions/LinearFunctionData"
        },
        {
          "$ref": "#/definitions/QuadraticFunctionData"
        },
        {
          "$ref": "#/definitions/PiecewiseLinearData"
        },
        {
          "$ref": "#/definitions/PiecewiseStepData"
        },
        {
          "$ref": "#/definitions/TimeSeriesLinearFunctionData"
        },
        {
          "$ref": "#/definitions/TimeSeriesQuadraticFunctionData"
        },
        {
          "$ref": "#/definitions/TimeSeriesPiecewiseLinearData"
        },
        {
          "$ref": "#/definitions/TimeSeriesPiecewiseStepData"
        }
      ],
      "title": "FunctionData",
      "type": "object"
    },
    "GenericOperationCost": {
      "discriminator": {
        "mapping": {
          "RENEWABLE": "#/components/schemas/RenewableGenerationCost",
          "THERMAL": "#/components/schemas/ThermalGenerationCost",
          "HYDRO_GEN": "#/components/schemas/HydroGenerationCost"
        },
        "propertyName": "cost_type"
      },
      "oneOf": [
        {
          "$ref": "#/definitions/ThermalGenerationCost"
        },
        {
          "$ref": "#/definitions/RenewableGenerationCost"
        },
        {
          "$ref": "#/definitions/HydroGenerationCost"
        }
      ],
      "title": "GenericOperationCost",
      "type": "object"
    },
    "HydroGenerationCost": {
      "description": "Cost representation for hydro gen units",
      "properties": {
        "cost_type": {
          "const": "HYDRO_GEN",
          "type": "string",
          "default": "HYDRO_GEN"
        },
        "fixed": {
          "default": 0.0,
          "type": "number"
        },
        "variable": {
          "$ref": "#/definitions/ProductionVariableCostCurve"
        }
      },
      "required": [
        "variable"
      ],
      "title": "HydroGenerationCost",
      "type": "object"
    },
    "HydroReservoirCost": {
      "description": "Cost representation for hydro reservoir",
      "properties": {
        "cost_type": {
          "const": "HYDRO_RES",
          "type": "string",
          "default": "HYDRO_RES"
        },
        "level_shortage_cost": {
          "default": 0.0,
          "type": "number"
        },
        "level_surplus_cost": {
          "default": 0.0,
          "type": "number"
        },
        "spillage_cost": {
          "default": 0.0,
          "type": "number"
        }
      },
      "title": "HydroReservoirCost",
      "type": "object"
    },
    "HydroStorageGenerationCost": {
      "title": "HydroStorageGenerationCost",
      "type": "object",
      "discriminator": {
        "mapping": {
          "HYDRO_GEN": "#/components/schemas/HydroGenerationCost",
          "STORAGE": "#/components/schemas/StorageCost"
        },
        "propertyName": "cost_type"
      },
      "oneOf": [
        {
          "$ref": "#/definitions/HydroGenerationCost"
        },
        {
          "$ref": "#/definitions/StorageCost"
        }
      ]
    },
    "ImpedanceUnitBasis": {
      "description": "Unit basis a branch/injection impedance is stored in. NATURAL_UNITS: physical ohms (PSS/E RAW native for DC-line impedances). COMPONENT_BASE: per-unit on the component's own base (base_power MVA and voltage base); components whose per-unit data was historically on the system base record that system base in base_power, so there is no separate system-base option. PSS/E supplies device base for DC-line converters and CZ=2 transformer windings. A branch's shunt admittance halves (b, g) share the branch's one basis: NATURAL_UNITS stores them in siemens.",
      "enum": [
        "NATURAL_UNITS",
        "COMPONENT_BASE"
      ],
      "title": "ImpedanceUnitBasis",
      "type": "string"
    },
    "AdmittanceUnitBasis": {
      "description": "Unit basis a shunt admittance is stored in. NATURAL_UNITS: physical siemens. COMPONENT_MVAR: reactive power at unity voltage (Mvar for susceptance, MW for conductance). COMPONENT_BASE: per-unit on the component's own base (base_power MVA and voltage base) — a per-unit base, not a power at unity voltage, and not an alternative spelling of COMPONENT_MVAR; components whose per-unit data was historically on the system base record that system base in base_power. Fixed and switched shunts use ShuntAdmittanceUnitBasis instead, which omits COMPONENT_BASE because a shunt has no device MVA rating.",
      "enum": [
        "NATURAL_UNITS",
        "COMPONENT_MVAR",
        "COMPONENT_BASE"
      ],
      "title": "AdmittanceUnitBasis",
      "type": "string"
    },
    "ShuntAdmittanceUnitBasis": {
      "description": "Subset of AdmittanceUnitBasis for fixed and switched shunts: omits COMPONENT_BASE because a shunt has no device MVA rating to per-unitize against. NATURAL_UNITS: physical siemens. COMPONENT_MVAR: reactive power at unity voltage (Mvar for susceptance, MW for conductance) — PSS/E RAW native for shunts.",
      "enum": [
        "NATURAL_UNITS",
        "COMPONENT_MVAR"
      ],
      "title": "ShuntAdmittanceUnitBasis",
      "type": "string"
    },
    "ImportExportCost": {
      "properties": {
        "cost_type": {
          "const": "IMPORTEXPORT",
          "type": "string",
          "default": "IMPORTEXPORT"
        },
        "import_offer_curves": {
          "$ref": "#/definitions/CostCurve"
        },
        "export_offer_curves": {
          "$ref": "#/definitions/CostCurve"
        },
        "energy_import_weekly_limit": {
          "type": "number",
          "x-unit": "MWh",
          "description": "Weekly limit on imported energy, in MWh. MWh is the only representation: neither producers nor consumers rescale it by a system base. Units: MWh."
        },
        "energy_export_weekly_limit": {
          "type": "number",
          "x-unit": "MWh",
          "description": "Weekly limit on exported energy, in MWh. MWh is the only representation: neither producers nor consumers rescale it by a system base. Units: MWh."
        }
      },
      "required": [
        "energy_import_weekly_limit",
        "energy_export_weekly_limit"
      ],
      "title": "ImportExportCost",
      "type": "object"
    },
    "ImportExportTimeSeriesCost": {
      "description": "Cost representation for time-varying imports and exports with neighboring areas. The static counterpart is ImportExportCost.",
      "properties": {
        "cost_type": {
          "const": "IMPORT_EXPORT_TIME_SERIES",
          "type": "string",
          "default": "IMPORT_EXPORT_TIME_SERIES"
        },
        "import_offer_curves": {
          "$ref": "#/definitions/CostCurve",
          "description": "Import price curves whose value curve admits only the TIME_SERIES_INCREMENTAL variant; any other variant is rejected by the consuming constructor."
        },
        "export_offer_curves": {
          "$ref": "#/definitions/CostCurve",
          "description": "Export price curves whose value curve admits only the TIME_SERIES_INCREMENTAL variant; any other variant is rejected by the consuming constructor."
        },
        "energy_import_weekly_limit": {
          "type": "number",
          "x-unit": "MWh",
          "description": "Weekly limit on imported energy, in MWh. MWh is the only representation: neither producers nor consumers rescale it by a system base. Units: MWh."
        },
        "energy_export_weekly_limit": {
          "type": "number",
          "x-unit": "MWh",
          "description": "Weekly limit on exported energy, in MWh. MWh is the only representation: neither producers nor consumers rescale it by a system base. Units: MWh."
        },
        "ancillary_service_offers": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      },
      "required": [
        "cost_type",
        "import_offer_curves",
        "export_offer_curves",
        "energy_import_weekly_limit",
        "energy_export_weekly_limit",
        "ancillary_service_offers"
      ],
      "title": "ImportExportTimeSeriesCost",
      "type": "object"
    },
    "IncrementalCurve": {
      "properties": {
        "curve_type": {
          "const": "INCREMENTAL",
          "type": "string",
          "default": "INCREMENTAL"
        },
        "function_data": {
          "discriminator": {
            "mapping": {
              "LINEAR": "#/components/schemas/LinearFunctionData",
              "PIECEWISE_STEP": "#/components/schemas/PiecewiseStepData"
            },
            "propertyName": "function_type"
          },
          "oneOf": [
            {
              "$ref": "#/definitions/LinearFunctionData"
            },
            {
              "$ref": "#/definitions/PiecewiseStepData"
            }
          ]
        },
        "initial_input": {
          "type": "number"
        },
        "input_at_zero": {
          "type": "number"
        }
      },
      "required": [
        "function_data",
        "curve_type"
      ],
      "title": "IncrementalCurve",
      "type": "object"
    },
    "InOut": {
      "properties": {
        "in": {
          "type": "number"
        },
        "out": {
          "type": "number"
        }
      },
      "title": "InOut",
      "type": "object"
    },
    "InputOutputCurve": {
      "default": {
        "curve_type": "INPUT_OUTPUT",
        "function_data": {
          "function_type": "LINEAR",
          "constant_term": 0,
          "proportional_term": 0
        }
      },
      "properties": {
        "curve_type": {
          "const": "INPUT_OUTPUT",
          "type": "string",
          "default": "INPUT_OUTPUT"
        },
        "function_data": {
          "discriminator": {
            "mapping": {
              "LINEAR": "#/components/schemas/LinearFunctionData",
              "PIECEWISE_LINEAR": "#/components/schemas/PiecewiseLinearData",
              "QUADRATIC": "#/components/schemas/QuadraticFunctionData"
            },
            "propertyName": "function_type"
          },
          "oneOf": [
            {
              "$ref": "#/definitions/QuadraticFunctionData"
            },
            {
              "$ref": "#/definitions/LinearFunctionData"
            },
            {
              "$ref": "#/definitions/PiecewiseLinearData"
            }
          ]
        },
        "input_at_zero": {
          "type": "number"
        }
      },
      "required": [
        "function_data",
        "curve_type"
      ],
      "title": "InputOutputCurve",
      "type": "object"
    },
    "LinearFunctionData": {
      "properties": {
        "constant_term": {
          "type": "number"
        },
        "function_type": {
          "const": "LINEAR",
          "type": "string",
          "default": "LINEAR"
        },
        "proportional_term": {
          "type": "number"
        }
      },
      "required": [
        "proportional_term",
        "constant_term",
        "function_type"
      ],
      "title": "LinearFunctionData",
      "type": "object"
    },
    "LoadCost": {
      "description": "Cost representation for controllable load units",
      "properties": {
        "cost_type": {
          "const": "LOAD",
          "type": "string",
          "default": "LOAD"
        },
        "fixed": {
          "default": 0.0,
          "type": "number"
        },
        "variable": {
          "$ref": "#/definitions/CostCurve"
        }
      },
      "required": [
        "variable"
      ],
      "title": "LoadCost",
      "type": "object"
    },
    "MassUnit": {
      "enum": [
        "KG",
        "LB",
        "SHORT_TON",
        "METRIC_TON"
      ],
      "title": "MassUnit",
      "type": "string"
    },
    "MarketBidCost": {
      "description": "Cost representation for static (non-time-varying) market bids of energy and ancillary services.",
      "properties": {
        "cost_type": {
          "const": "MARKET_BID",
          "type": "string",
          "default": "MARKET_BID"
        },
        "minimum_energy_offer": {
          "description": "Minimum-energy offer: cost to operate at minimum stable level, in $/MWh at the curve's minimum power, stored as submitted. $/h sources convert at parse (MEO = no-load cost / P_min). Legacy scalar promotion: a bare scalar value `s` from a legacy source converts to an `InputOutputCurve` of `LinearFunctionData` with `constant_term = s` and `proportional_term = 0`.",
          "default": {
            "curve_type": "INPUT_OUTPUT",
            "function_data": {
              "function_type": "LINEAR",
              "constant_term": 0,
              "proportional_term": 0
            }
          },
          "$ref": "#/definitions/InputOutputCurve"
        },
        "start_up": {
          "description": "Start-up cost at different stages of the thermal cycle (hot, warm, cold).",
          "$ref": "#/definitions/StartUpStages"
        },
        "shut_down": {
          "description": "Shut-down cost. Legacy scalar promotion: a bare scalar value `s` from a legacy source converts to an `InputOutputCurve` of `LinearFunctionData` with `constant_term = s` and `proportional_term = 0`.",
          "default": {
            "curve_type": "INPUT_OUTPUT",
            "function_data": {
              "function_type": "LINEAR",
              "constant_term": 0,
              "proportional_term": 0
            }
          },
          "$ref": "#/definitions/InputOutputCurve"
        },
        "incremental_offer_curves": {
          "description": "Sell offer curves data as a `CostCurve` of `PiecewiseIncrementalCurve`.",
          "$ref": "#/definitions/CostCurve"
        },
        "decremental_offer_curves": {
          "description": "Buy offer curves data as a `CostCurve` of `PiecewiseIncrementalCurve`.",
          "$ref": "#/definitions/CostCurve"
        },
        "ancillary_service_offers": {
          "description": "IDs of the ancillary service components that this market bid offers into.",
          "type": "array",
          "items": {
            "type": "integer"
          }
        },
        "incremental_slope": {
          "description": "Linear-interpolation flag for the incremental offer curves; false (default) is the step interpretation. Mutually exclusive with block groups on the same curve.",
          "type": "boolean",
          "default": false
        },
        "decremental_slope": {
          "description": "Linear-interpolation flag for the decremental offer curves; false (default) is the step interpretation. Mutually exclusive with block groups on the same curve.",
          "type": "boolean",
          "default": false
        },
        "curve_style": {
          "description": "Curve-clearing style for the bid: 0 = CURVE (ordinary divisible price-setting curve, default); 1 = FIXED (clears as one indivisible all-or-nothing package over its period); 2 = VARIABLE (divisible quantity, block-priced, cannot set the settlement-point price). Corresponds to ERCOT's DAM PriceCurve curveStyle field (CURVE/FIXED/VARIABLE). A non-zero value is mutually exclusive with incremental_slope/decremental_slope.",
          "type": "integer",
          "enum": [0, 1, 2],
          "default": 0
        }
      },
      "required": [
        "minimum_energy_offer",
        "start_up",
        "shut_down",
        "incremental_offer_curves",
        "decremental_offer_curves",
        "ancillary_service_offers"
      ],
      "title": "MarketBidCost",
      "type": "object"
    },
    "MarketBidTimeSeriesCost": {
      "description": "Cost representation for time-varying market bids of energy and ancillary services. The static counterpart is MarketBidCost.",
      "properties": {
        "cost_type": {
          "const": "MARKET_BID_TIME_SERIES",
          "type": "string",
          "default": "MARKET_BID_TIME_SERIES"
        },
        "minimum_energy_offer": {
          "$ref": "#/definitions/TimeSeriesInputOutputCurve",
          "description": "Minimum-energy offer: cost to operate at minimum stable level, in $/MWh at the curve's minimum power, stored as submitted. $/h sources convert at parse (MEO = no-load cost / P_min). Time-series-backed linear curve; only the TIME_SERIES_LINEAR function-data variant is admissible here — the consuming constructor rejects any other."
        },
        "start_up_association_id": {
          "type": "integer",
          "description": "Store-minted id of a time series of three-stage (hot, warm, cold) start-up costs."
        },
        "shut_down": {
          "$ref": "#/definitions/TimeSeriesInputOutputCurve",
          "description": "Shut-down cost as a time-series-backed linear curve. Only the TIME_SERIES_LINEAR function-data variant is admissible here; the consuming constructor rejects any other."
        },
        "incremental_offer_curves": {
          "$ref": "#/definitions/CostCurve",
          "description": "Sell offer curves whose value curve is a time-series-backed piecewise incremental curve. Only the TIME_SERIES_INCREMENTAL variant is admissible here; any other variant is rejected by the consuming constructor."
        },
        "decremental_offer_curves": {
          "$ref": "#/definitions/CostCurve",
          "description": "Buy offer curves whose value curve is a time-series-backed piecewise incremental curve. Only the TIME_SERIES_INCREMENTAL variant is admissible here; any other variant is rejected by the consuming constructor."
        },
        "ancillary_service_offers": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "description": "IDs of the ancillary service components that this bid offers into."
        },
        "incremental_slope": {
          "description": "Linear-interpolation flag for the incremental offer curves; false (default) is the step interpretation. Mutually exclusive with block groups on the same curve.",
          "type": "boolean",
          "default": false
        },
        "decremental_slope": {
          "description": "Linear-interpolation flag for the decremental offer curves; false (default) is the step interpretation. Mutually exclusive with block groups on the same curve.",
          "type": "boolean",
          "default": false
        },
        "curve_style": {
          "description": "Curve-clearing style for the bid: 0 = CURVE (ordinary divisible price-setting curve, default); 1 = FIXED (clears as one indivisible all-or-nothing package over its period); 2 = VARIABLE (divisible quantity, block-priced, cannot set the settlement-point price). Corresponds to ERCOT's DAM PriceCurve curveStyle field (CURVE/FIXED/VARIABLE). A non-zero value is mutually exclusive with incremental_slope/decremental_slope.",
          "type": "integer",
          "enum": [0, 1, 2],
          "default": 0
        }
      },
      "required": [
        "cost_type",
        "minimum_energy_offer",
        "start_up_association_id",
        "shut_down",
        "incremental_offer_curves",
        "decremental_offer_curves",
        "ancillary_service_offers"
      ],
      "title": "MarketBidTimeSeriesCost",
      "type": "object"
    },
    "MinMax": {
      "properties": {
        "max": {
          "title": "Max",
          "type": "number"
