{
  "version": "1.0",
  "convention": "sienna-units-1.0",
  "notes": "Single source of truth for the Sienna unit vocabulary. 'dimension' is an exponent map over base dimensions M (mass, kg), L (length, m), T (time, s), I (electric current, A), and pseudo-dimensions USD (money) and Btu (fuel chemical energy, kept distinct from electrical energy so heat-rate and fuel-intensity quantities never collide with cost quantities). Dimensionless quantities use the empty exponent map {} and the single allowed unit \"1\"; percent is banned (store fractions). 'to_default' in allowed_units is the exact multiplicative factor converting a value in 'unit' to the quantity's default_unit; it is null where conversion is context-dependent rather than a fixed factor (e.g. pu bases), and 0.0 where this layer deliberately does not perform the conversion at all (e.g. Angle). For Frequency/Hz, to_default instead records the nominal system frequency (60.0), not a conversion factor. 'ucum' carries the UCUM code of the default_unit where one exists, else null.",
  "quantity_types": [
    {"name": "ActivePower", "dimension": {"M": 1, "L": 2, "T": -3}, "default_unit": "MW", "ucum": "MW", "description": "Active (real) power"},
    {"name": "ReactivePower", "dimension": {"M": 1, "L": 2, "T": -3}, "default_unit": "MVAr", "ucum": null, "description": "Reactive power"},
    {"name": "ApparentPower", "dimension": {"M": 1, "L": 2, "T": -3}, "default_unit": "MVA", "ucum": null, "description": "Apparent power"},
    {"name": "ActivePowerChangeRate", "dimension": {"M": 1, "L": 2, "T": -4}, "default_unit": "MW/min", "ucum": null, "description": "Rate of change of active power (ramp)"},
    {"name": "ElectricalEnergy", "dimension": {"M": 1, "L": 2, "T": -2}, "default_unit": "MWh", "ucum": null, "description": "Real (electrical) energy"},
    {"name": "Voltage", "dimension": {"M": 1, "L": 2, "T": -3, "I": -1}, "default_unit": "kV", "ucum": "kV", "description": "Voltage"},
    {"name": "CurrentFlow", "dimension": {"I": 1}, "default_unit": "kA", "ucum": "kA", "description": "Current flow"},
    {"name": "Resistance", "dimension": {"M": 1, "L": 2, "T": -3, "I": -2}, "default_unit": "ohm", "ucum": "Ohm", "description": "Resistance"},
    {"name": "Reactance", "dimension": {"M": 1, "L": 2, "T": -3, "I": -2}, "default_unit": "ohm", "ucum": "Ohm", "description": "Reactance"},
    {"name": "Impedance", "dimension": {"M": 1, "L": 2, "T": -3, "I": -2}, "default_unit": "ohm", "ucum": "Ohm", "description": "Impedance"},
    {"name": "Conductance", "dimension": {"M": -1, "L": -2, "T": 3, "I": 2}, "default_unit": "S", "ucum": "S", "description": "Conductance"},
    {"name": "Susceptance", "dimension": {"M": -1, "L": -2, "T": 3, "I": 2}, "default_unit": "S", "ucum": "S", "description": "Susceptance"},
    {"name": "Angle", "dimension": {}, "default_unit": "rad", "ucum": "rad", "description": "Angle (allowed units rad and deg)"},
    {"name": "Frequency", "dimension": {"T": -1}, "default_unit": "Hz", "ucum": "Hz", "description": "Frequency"},
    {"name": "PowerPerFrequency", "dimension": {"M": 1, "L": 2, "T": -2}, "default_unit": "MW/Hz", "ucum": null, "description": "Active power response per unit of frequency deviation (regulation / droop participation)"},
    {"name": "Length", "dimension": {"L": 1}, "default_unit": "km", "ucum": "km", "description": "Length"},
    {"name": "Elevation", "dimension": {"L": 1}, "default_unit": "m", "ucum": "m", "description": "Elevation / hydraulic head"},
    {"name": "Duration", "dimension": {"T": 1}, "default_unit": "h", "ucum": "h", "description": "Duration (allowed units h, yr, min, s)"},
    {"name": "Dimensionless", "dimension": {}, "default_unit": "1", "ucum": "1", "description": "Dimensionless quantity"},
    {"name": "Fraction", "dimension": {}, "default_unit": "1", "ucum": "1", "description": "Fractional quantity (efficiency, losses, cofire level, etc.)"},
    {"name": "PowerFactor", "dimension": {}, "default_unit": "1", "ucum": "1", "description": "Power factor"},
    {"name": "HeatRate", "dimension": {"Btu": 1, "M": -1, "L": -2, "T": 2}, "default_unit": "MMBtu/MWh", "ucum": null, "description": "Heat rate (fuel energy per unit of electrical energy)"},
    {"name": "StartFuelPerCapacity", "dimension": {"Btu": 1, "M": -1, "L": -2, "T": 3}, "default_unit": "MMBtu/MW", "ucum": null, "description": "Start-up fuel per unit of capacity"},
    {"name": "VolumeFlowRate", "dimension": {"L": 3, "T": -1}, "default_unit": "m3/s", "ucum": null, "description": "Volumetric flow rate"},
    {"name": "HeadRate", "dimension": {"L": 1, "T": -1}, "default_unit": "m/s", "ucum": null, "description": "Rate of change of hydraulic head"},
    {"name": "Volume", "dimension": {"L": 3}, "default_unit": "m3", "ucum": null, "description": "Volume"},
    {"name": "Inductance", "dimension": {"M": 1, "L": 2, "T": -2, "I": -2}, "default_unit": "H", "ucum": null, "description": "Inductance"},
    {"name": "Capacitance", "dimension": {"M": -1, "L": -2, "T": 4, "I": 2}, "default_unit": "F", "ucum": null, "description": "Capacitance"},
    {"name": "CostPerCapacity", "dimension": {"USD": 1, "M": -1, "L": -2, "T": 3}, "default_unit": "USD/MW", "ucum": null, "description": "Cost per unit of capacity (capital cost)"},
    {"name": "CostPerEnergy", "dimension": {"USD": 1, "M": -1, "L": -2, "T": 2}, "default_unit": "USD/MWh", "ucum": null, "description": "Cost per unit of energy (operation / energy capital cost)"},
    {"name": "CostPerTime", "dimension": {"USD": 1, "T": -1}, "default_unit": "USD/h", "ucum": null, "description": "Cost per unit of time"},
    {"name": "CO2Emissions", "dimension": {"M": 1, "Btu": -1}, "default_unit": "t/MMBtu", "ucum": null, "description": "CO2 emission rate (mass per unit of fuel energy)"},
    {"name": "Mass", "dimension": {"M": 1}, "default_unit": "t", "ucum": null, "description": "Mass"},
    {"name": "Money", "dimension": {"USD": 1}, "default_unit": "USD", "ucum": null, "description": "Monetary value"},
    {"name": "CostPerVolume", "dimension": {"USD": 1, "L": -3}, "default_unit": "USD/m3", "ucum": null, "description": "Cost per unit of volume (e.g. reservoir operation cost)"},
    {"name": "CostPerLevel", "dimension": {"USD": 1, "L": -1}, "default_unit": "USD/m", "ucum": null, "description": "Cost per unit of hydraulic head (e.g. reservoir operation cost when level_data_type=HEAD)"},
    {"name": "EmissionRate", "dimension": {"L": -2, "T": 2}, "default_unit": "t/MWh", "ucum": null, "description": "Emission mass per unit of electrical energy"},
    {"name": "CostPerMass", "dimension": {"USD": 1, "M": -1}, "default_unit": "USD/t", "ucum": null, "description": "Cost per unit of mass (e.g. carbon price or tax)"}
  ],
