{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "id": {
      "description": "Unique integer identifier for this component",
      "type": "integer"
    },
    "kq": {
      "description": "frequency droop gain",
      "type": "number"
    },
    "reactive_power_filter_frequency": {
      "description": "Filter cutoff frequency, in natural units. Units: Hz.",
      "type": "number",
      "x-unit": "Hz"
    },
    "V_ref": {
      "description": "Reference Voltage Set-point (pu). Units: pu.",
      "type": "number",
      "default": 1.0,
      "x-unit": "pu",
      "x-quantity": "Voltage"
    }
  },
  "required": [
    "id",
    "kq",
    "reactive_power_filter_frequency"
  ],
  "title": "ReactivePowerDroop",
  "type": "object"
}
