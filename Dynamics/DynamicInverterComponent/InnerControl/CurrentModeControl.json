{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "id": {
      "description": "Unique integer identifier for this component",
      "type": "integer"
    },
    "kpc": {
      "description": "Current controller proportional gain",
      "type": "number"
    },
    "kic": {
      "description": "Current controller integral gain",
      "type": "number"
    },
    "kffv": {
      "description": "Gain to enable feed-forward gain of voltage",
      "type": "number"
    }
  },
  "required": [
    "id",
    "kpc",
    "kic",
    "kffv"
  ],
  "title": "CurrentModeControl",
  "type": "object"
}
