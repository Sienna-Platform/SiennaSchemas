{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Parameters of a LCL filter outside the converter",
  "properties": {
    "id": {
      "description": "Unique integer identifier for this component",
      "type": "integer"
    },
    "lf": {
      "description": "Filter inductance",
      "type": "number"
    },
    "rf": {
      "description": "Filter resistance",
      "type": "number"
    },
    "cf": {
      "description": "Filter capacitance",
      "type": "number"
    }
  },
  "required": [
    "id",
    "lf",
    "rf",
    "cf"
  ],
  "title": "LCFilter",
  "type": "object"
}
