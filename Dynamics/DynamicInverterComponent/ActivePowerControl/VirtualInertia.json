{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "id": {
      "description": "Unique integer identifier for this component",
      "type": "integer"
    },
    "Ta": {
      "description": "VSM inertia constant Units: s.",
      "type": "number",
      "x-unit": "s"
    },
    "kd": {
      "description": "VSM damping constant",
      "type": "number"
    },
    "k_frequency": {
      "description": "frequency droop gain",
      "type": "number"
    },
    "P_ref": {
      "description": "Reference Power Set-point (pu) Units: pu.",
      "type": "number",
      "default": 1.0,
      "x-unit": "pu",
      "x-quantity": "ActivePower"
    }
  },
  "required": [
    "id",
    "Ta",
    "kd",
    "k_frequency"
  ],
  "title": "VirtualInertia",
  "type": "object"
}
