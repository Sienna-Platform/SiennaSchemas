{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Parameters of an Automatic Voltage Regulator Type II - Typical static exciter model",
  "properties": {
    "id": {
      "description": "Unique integer identifier for this component",
      "type": "integer"
    },
    "K0": {
      "description": "Regulator gain",
      "type": "number"
    },
    "T1": {
      "description": "First pole in s",
      "type": "number"
    },
    "T2": {
      "description": "First zero in s",
      "type": "number"
    },
    "T3": {
      "description": "First pole in s",
      "type": "number"
    },
    "T4": {
      "description": "First zero in s",
      "type": "number"
    },
    "Te": {
      "description": "Field circuit time constant",
      "type": "number"
    },
    "Tr": {
      "description": "Voltage measurement time constant",
      "type": "number"
    },
    "Va_lim": {
      "description": "Limits for pi controller",
      "$ref": "../../Core/common.json#/definitions/MinMax"
    },
    "Ae": {
      "description": "1st ceiling coefficient",
      "type": "number"
    },
    "Be": {
      "description": "2nd ceiling coefficient",
      "type": "number"
    },
    "V_ref": {
      "description": "Reference voltage set-point",
      "default": 1.0,
      "type": "number"
    }
  },
  "required": [
    "id",
    "K0",
    "T1",
    "T2",
    "T3",
    "T$",
    "Te",
    "Tr",
    "Va_lim",
    "Ae",
    "Be"
  ],
  "title": "AVRTypeII",
  "type": "object"
}
