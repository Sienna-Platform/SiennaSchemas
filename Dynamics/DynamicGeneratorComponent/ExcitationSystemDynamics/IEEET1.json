{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "1968 IEEE type 1 excitation system model",
  "properties": {
    "id": {
      "description": "Unique integer identifier for this component",
      "type": "integer"
    },
    "Tr": {
      "description": "Voltage measurement time constant Units: s.",
      "type": "number",
      "x-unit": "s"
    },
    "Ka": {
      "description": "Amplifier gain",
      "type": "number"
    },
    "Ta": {
      "description": "Amplifier time constant Units: s.",
      "type": "number",
      "x-unit": "s"
    },
    "Vr_lim": {
      "description": "Voltage regulator limits (regulator output)",
      "$ref": "../../../Core/common.json#/$defs/MinMax"
    },
    "Ke": {
      "description": "Exciter constant related to self-excited field",
      "type": "number"
    },
    "Te": {
      "description": "Exciter time constant, integration rate associated with exciter control Units: s.",
      "type": "number",
      "x-unit": "s"
    },
    "Kf": {
      "description": "Excitation control system stabilizer gain",
      "type": "number"
    },
    "Tf": {
      "description": "Excitation control system stabilizer time constant Units: s.",
      "type": "number",
      "x-unit": "s"
    },
    "switch": {
      "description": "Switch",
      "type": "integer"
    },
    "E_sat": {
      "type": "array",
      "description": "Exciter output voltage for saturation factor",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "Se": {
      "type": "array",
      "description": "Exciter saturation factor at exciter output voltage",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "V_ref": {
      "description": "Reference voltage set-point",
      "default": 1.0,
      "type": "number"
    }
  },
  "required": [
    "id",
    "Tr",
    "Ka",
    "Ta",
    "Vr_lim",
    "Ke",
    "Te",
    "Kf",
    "Tf",
    "switch",
    "E_sat",
    "Se"
  ],
  "title": "IEEET1",
  "type": "object"
}
