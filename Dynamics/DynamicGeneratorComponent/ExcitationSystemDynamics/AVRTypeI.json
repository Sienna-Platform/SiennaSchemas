{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Parameters of an Automatic Voltage Regulator Type I - Resembles IEEE Type DC1",
  "properties": {
    "id": {
      "description": "Unique integer identifier for this component",
      "type": "integer"
    },
    "base_power": {
      "description": "Base power for this model's per-unit parameters. Usually equal to the `base_power` of the dynamic injection that names this model; the ingestion layer reconciles a difference. Units: MVA.",
      "type": "number",
      "exclusiveMinimum": 0,
      "x-unit": "MVA"
    },
    "Ka": {
      "description": "Amplifier gain",
      "type": "number"
    },
    "Ke": {
      "description": "Field circuit integral deviation",
      "type": "number"
    },
    "Kf": {
      "description": "Stabilizer gain",
      "type": "number"
    },
    "Ta": {
      "description": "Amplifier time constant",
      "type": "number"
    },
    "Te": {
      "description": "Field circuit time constant",
      "type": "number"
    },
    "Tf": {
      "description": "Stabilizer time constant",
      "type": "number"
    },
    "Tr": {
      "description": "Voltage measurement time constant",
      "type": "number"
    },
    "Va_lim": {
      "description": "Limits for pi controller",
      "$ref": "../../../Core/common.json#/$defs/MinMax"
    },
    "Ae": {
      "description": "1st ceiling coefficient",
      "type": "number"
    },
    "Be": {
      "description": "2nd ceiling coefficient",
      "type": "number"
    },
    "V_ref": {
      "description": "Reference voltage set-point",
      "default": 1.0,
      "type": "number"
    }
  },
  "required": [
    "id",
    "base_power",
    "Ka",
    "Ke",
    "Kf",
    "Ta",
    "Te",
    "Tf",
    "Tr",
    "Va_lim",
    "Ae",
    "Be"
  ],
  "title": "AVRTypeI",
  "type": "object"
}
