{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Parameters of an Automatic Voltage Regulator Type II - Typical static exciter model",
  "properties": {
    "id": {
      "description": "Unique integer identifier for this component",
      "type": "integer"
    },
    "K0": {
      "description": "Regulator gain",
      "type": "number"
    },
    "T1": {
      "description": "First pole in s Units: s.",
      "type": "number",
      "x-unit": "s"
    },
    "T2": {
      "description": "First zero in s Units: s.",
      "type": "number",
      "x-unit": "s"
    },
    "T3": {
      "description": "First pole in s Units: s.",
      "type": "number",
      "x-unit": "s"
    },
    "T4": {
      "description": "First zero in s Units: s.",
      "type": "number",
      "x-unit": "s"
    },
    "Te": {
      "description": "Field circuit time constant Units: s.",
      "type": "number",
      "x-unit": "s"
    },
    "Tr": {
      "description": "Voltage measurement time constant Units: s.",
      "type": "number",
      "x-unit": "s"
    },
    "Va_lim": {
      "description": "Limits for pi controller",
      "$ref": "../../../Core/common.json#/$defs/MinMax"
    },
    "Ae": {
      "description": "1st ceiling coefficient",
      "type": "number"
    },
    "Be": {
      "description": "2nd ceiling coefficient",
      "type": "number"
    },
    "V_ref": {
      "description": "Reference voltage set-point",
      "default": 1.0,
      "type": "number"
    }
  },
  "required": [
    "id",
    "K0",
    "T1",
    "T2",
    "T3",
    "T4",
    "Te",
    "Tr",
    "Va_lim",
    "Ae",
    "Be"
  ],
  "title": "AVRTypeII",
  "type": "object"
}
