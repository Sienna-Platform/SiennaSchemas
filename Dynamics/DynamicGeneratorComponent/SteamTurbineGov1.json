{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Steam Turbine-Governor. This model considers both TGOV1 or TGOV1DU in PSS/E.",
  "properties": {
    "id": {
      "description": "Unique integer identifier for this component.",
      "type": "integer"
    },
    "R": {
      "description": "Droop parameter.",
      "type": "number"
    },
    "T1": {
      "description": "Governor time constant.",
      "type": "number",
      "x-unit": "s"
    },
    "valve_position_limits": {
      "description": "Valve position limits.",
      "$ref": "../../Core/common.json#/definitions/MinMax"
    },
    "T2": {
      "description": "Lead Lag Lead Time constant.",
      "type": "number",
      "x-unit": "s"
    },
    "T3": {
      "description": "Lead Lag Lag Time constant.",
      "type": "number",
      "x-unit": "s"
    },
    "D_T": {
      "description": "Turbine Damping.",
      "type": "number"
    },
    "DB_h": {
      "description": "Deadband for overspeed.",
      "type": "number"
    },
    "DB_l": {
      "description": "Deadband for underspeed.",
      "type": "number"
    },
    "T_rate": {
      "description": "Turbine Rate. If zero, generator base is used.",
      "type": "number",
      "x-unit": "MW"
    },
    "P_ref": {
      "description": "Reference Power Set-point.",
      "type": "number"
    }
  },
  "required": [
    "id",
    "R",
    "T1",
    "valve_position_limits",
    "T2",
    "T3",
    "D_T",
    "DB_h",
    "DB_l",
    "T_rate"
  ],
  "title": "SteamTurbineGov1",
  "type": "object"
}
