{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Parameters of a turbine governor type II",
  "properties": {
    "id": {
      "description": "Unique integer identifier for this component",
      "type": "integer"
    },
    "base_power": {
      "description": "Base power for this model's per-unit parameters. Usually equal to the `base_power` of the dynamic injection that names this model; the ingestion layer reconciles a difference. Units: MVA.",
      "type": "number",
      "exclusiveMinimum": 0,
      "x-unit": "MVA"
    },
    "R": {
      "description": "Droop parameter",
      "type": "number"
    },
    "T1": {
      "description": "Transient gain time constant",
      "type": "number"
    },
    "T2": {
      "description": "Power fraction time constant",
      "type": "number"
    },
    "tau_limits": {
      "description": "Power limits into the governor",
      "$ref": "../../../Core/common.json#/$defs/MinMax"
    },
    "P_ref": {
      "description": "Reference power set-point",
      "type": "number"
    }
  },
  "required": [
    "id",
    "base_power",
    "R",
    "T1",
    "T2",
    "tau_limits"
  ],
  "title": "TGTypeII",
  "type": "object"
}
