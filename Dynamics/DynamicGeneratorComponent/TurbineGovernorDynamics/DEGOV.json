{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Parameters Woodward Diesel Governor Model. DEGOV in PowerWorld",
  "properties": {
    "id": {
      "description": "Unique integer identifier for this component",
      "type": "integer"
    },
    "base_power": {
      "description": "Base power for this model's per-unit parameters. Usually equal to the `base_power` of the dynamic injection that names this model; the ingestion layer reconciles a difference. Units: MVA.",
      "type": "number",
      "exclusiveMinimum": 0,
      "x-unit": "MVA"
    },
    "T1": {
      "description": "Governor mechanism time constant",
      "type": "number"
    },
    "T2": {
      "description": "Turbine power time constant",
      "type": "number"
    },
    "T3": {
      "description": "Turbine exhaust temperature time constant",
      "type": "number"
    },
    "K": {
      "description": "Governor gain (reciproical of droop)",
      "type": "number"
    },
    "T4": {
      "description": "Governor lead time constant",
      "type": "number"
    },
    "T5": {
      "description": "Governor lag time constant",
      "type": "number"
    },
    "T6": {
      "description": "Actuator time constant",
      "type": "number"
    },
    "Td": {
      "description": "Engine time delay",
      "type": "number"
    },
    "P_ref": {
      "description": "Reference power set-point",
      "default": 1.0,
      "type": "number"
    }
  },
  "required": [
    "id",
    "base_power",
    "T1",
    "T2",
    "T3",
    "K",
    "T4",
    "T5",
    "T6",
    "Td"
  ],
  "title": "DEGOV",
  "type": "object"
}
