{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Hydro turbine-governor",
  "properties": {
    "id": {
      "description": "Unique integer identifier for this component",
      "type": "integer"
    },
    "R_BIG": {
      "description": "Permanent droop, in pu.",
      "type": "number"
    },
    "R_SMALL": {
      "description": "Temporary droop, in pu.",
      "type": "number"
    },
    "Tr": {
      "description": "Governor time constant. Units: s.",
      "type": "number",
      "x-unit": "s"
    },
    "Tf": {
      "description": "Filter time constant. Units: s.",
      "type": "number",
      "x-unit": "s"
    },
    "Tg": {
      "description": "Servo time constant. Units: s.",
      "type": "number",
      "x-unit": "s"
    },
    "VELM": {
      "description": "Gate velocity limit",
      "type": "number"
    },
    "gate_position_limits": {
      "description": "Gate position limits",
      "$ref": "../../../Core/common.json#/$defs/MinMax"
    },
    "Tw": {
      "description": "Water time constant. Units: s.",
      "type": "number",
      "x-unit": "s"
    },
    "At": {
      "description": "Turbine gain",
      "type": "number"
    },
    "D_T": {
      "description": "Turbine damping",
      "type": "number"
    },
    "q_nl": {
      "description": "No power flow",
      "type": "number"
    },
    "P_ref": {
      "description": "Reference load set-point",
      "default": 1.0,
      "type": "number"
    }
  },
  "required": [
    "id",
    "R_BIG",
    "R_SMALL",
    "Tr",
    "Tf",
    "Tg",
    "VELM",
    "gate_position_limits",
    "Tw",
    "At",
    "D_T",
    "q_nl"
  ],
  "title": "HydroTurbineGov",
  "type": "object"
}
