{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Parameters of a turbine governor type I",
  "properties": {
    "id": {
      "description": "Unique integer identifier for this component",
      "type": "integer"
    },
    "R": {
      "description": "Droop parameter",
      "type": "number"
    },
    "Ts": {
      "description": "Governor time constant. Units: s.",
      "type": "number",
      "x-unit": "s"
    },
    "Tc": {
      "description": "Servo time constant. Units: s.",
      "type": "number",
      "x-unit": "s"
    },
    "T3": {
      "description": "Transient gain time constant",
      "type": "number"
    },
    "T4": {
      "description": "Power fraction time constant. Units: s.",
      "type": "number",
      "x-unit": "s"
    },
    "T5": {
      "description": "Reheat time constant. Units: s.",
      "type": "number",
      "x-unit": "s"
    },
    "valve_position_limits": {
      "description": "Valve position limits",
      "$ref": "../../../Core/common.json#/$defs/MinMax"
    },
    "P_ref": {
      "description": "Reference power set-point",
      "type": "number"
    }
  },
  "required": [
    "id",
    "R",
    "Ts",
    "Tc",
    "T3",
    "T4",
    "T5",
    "valve_position_limits"
  ],
  "title": "TGTypeI",
  "type": "object"
}
