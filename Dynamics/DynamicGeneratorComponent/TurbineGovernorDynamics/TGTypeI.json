{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Parameters of a turbine governor type I",
  "properties": {
    "id": {
      "description": "Unique integer identifier for this component",
      "type": "integer"
    },
    "base_power": {
      "description": "Base power for this model's per-unit parameters. Usually equal to the `base_power` of the dynamic injection that names this model; the ingestion layer reconciles a difference. Units: MVA.",
      "type": "number",
      "exclusiveMinimum": 0,
      "x-unit": "MVA"
    },
    "R": {
      "description": "Droop parameter",
      "type": "number"
    },
    "Ts": {
      "description": "Governor time constant",
      "type": "number"
    },
    "Tc": {
      "description": "Servo time constant",
      "type": "number"
    },
    "T3": {
      "description": "Transient gain time constant",
      "type": "number"
    },
    "T4": {
      "description": "Power fraction time constant",
      "type": "number"
    },
    "T5": {
      "description": "Reheat time constant",
      "type": "number"
    },
    "valve_position_limits": {
      "description": "Valve position limits",
      "$ref": "../../../Core/common.json#/$defs/MinMax"
    },
    "P_ref": {
      "description": "Reference power set-point",
      "type": "number"
    }
  },
  "required": [
    "id",
    "base_power",
    "R",
    "Ts",
    "Tc",
    "T3",
    "T4",
    "T5",
    "valve_position_limits"
  ],
  "title": "TGTypeI",
  "type": "object"
}
