{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Speed-sensitive stabilizing model",
  "properties": {
    "id": {
      "description": "Unique integer identifier for this component",
      "type": "integer"
    },
    "base_power": {
      "description": "Base power for this model's per-unit parameters. Usually equal to the `base_power` of the dynamic injection that names this model; the ingestion layer reconciles a difference. Units: MVA.",
      "type": "number",
      "exclusiveMinimum": 0,
      "x-unit": "MVA"
    },
    "KT": {
      "description": "K/T for washout filter",
      "type": "number"
    },
    "T": {
      "description": "Time constant for washout filter",
      "type": "number"
    },
    "T1T3": {
      "description": "Time constant division T1/T3",
      "type": "number"
    },
    "T3": {
      "description": "Time constant",
      "type": "number"
    },
    "T2T4": {
      "description": "Time constant division T2/T4",
      "type": "number"
    },
    "T4": {
      "description": "Time constant",
      "type": "number"
    },
    "H_lim": {
      "description": "PSS output limit",
      "type": "number"
    }  
  },
  "required": [
    "id",
    "base_power",
    "KT",
    "T",
    "T1T3",
    "T3",
    "T2T4",
    "T4",
    "H_lim"
  ],
  "title": "STAB1",
  "type": "object"
}
