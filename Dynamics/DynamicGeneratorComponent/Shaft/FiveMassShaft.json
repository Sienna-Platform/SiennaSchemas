{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Parameters of 5 mass-spring shaft model. It contains a High-Pressure (HP) steam turbine, Intermediate-Pressure (IP) steam turbine, Low-Pressure (LP) steam turbine, the Rotor and an Exciter (EX) mover",
  "properties": {
    "id": {
      "description": "Unique integer identifier for this component",
      "type": "integer"
    },
    "H": {
      "description": "Rotor inertia constant in MWs/MVA",
      "type": "number"
    },
    "H_hp": {
      "description": "High pressure turbine inertia constant in MWs/MVA",
      "type": "number"
    },
    "H_ip": {
      "description": "Intermediate pressure turbine inertia constant in MWs/MVA",
      "type": "number"
    },
    "H_lp": {
      "description": "Low pressure turbine inertia constant in MWs/MVA",
      "type": "number"
    },
    "H_ex": {
      "description": "Exciter inertia constant in MWs/MVA",
      "type": "number"
    },
    "D": {
      "description": "Rotor natural damping",
      "type": "number"
    },
    "D_hp": {
      "description": "High pressure turbine natural damping",
      "type": "number"
    },
    "D_ip": {
      "description": "Intermediate pressure turbine natural damping",
      "type": "number"
    },
    "D_lp": {
      "description": "Low pressure turbine natural damping",
      "type": "number"
    },
    "D_ex": {
      "description": "Exciter natural damping",
      "type": "number"
    },
    "D_12": {
      "description": "High-intermediate pressure turbine damping",
      "type": "number"
    },
    "D_23": {
      "description": "Intermediate-low pressure turbine damping",
      "type": "number"
    },
    "D_34": {
      "description": "Low pressure turbine-rotor damping",
      "type": "number"
    },
    "D_45": {
      "description": "Rotor-exciter damping",
      "type": "number"
    },
    "K_hp": {
      "description": "High pressure turbine angle coefficient",
      "type": "number"
    },
    "K_ip": {
      "description": "Intermediate pressure turbine angle coefficient",
      "type": "number"
    },
    "K_lp": {
      "description": "Low pressure turbine angle coefficient",
      "type": "number"
    },
    "K_ex": {
      "description": "Exciter angle coefficient",
      "type": "number"
    }  
  },
  "required": [
    "id",
    "H",
    "H_hp",
    "H_ip",
    "H_lp",
    "H_ex",
    "D",
    "D_hp",
    "D_ip",
    "D_lp",
    "D_ex",
    "D_12",
    "D_23",
    "D_34",
    "D_45",
    "K_hp",
    "K_ip",
    "K_lp",
    "K_ex"
  ],
  "title": "FiveMassShaft",
  "type": "object"
}
